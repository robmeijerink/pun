parameters:
	level: 0
	scanDirectories:
		- ../src
	filesRootDir: %currentWorkingDirectory%/tests/fixtures/disallowed
	paths:
		- "../src/disallowed/functionCalls.php"
		- "../src/disallowed-allow/functionCalls.php"
	disallowedFunctionCalls:
		-
			"function": "isset()"
			"allowIn": 
				- "src/disallowed-allow/*.php"
				- "src/*-allow/*.*"
