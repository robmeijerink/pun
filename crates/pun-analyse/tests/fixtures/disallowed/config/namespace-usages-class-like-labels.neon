parameters:
	level: 0
	scanDirectories:
		- ../src
	filesRootDir: %currentWorkingDirectory%/tests/fixtures/disallowed
	paths:
		- "../src/ClassLikeLabels.php"
	disallowedNamespaces:
		-
			"class": "ClassLikeLabels\\SomeInterface"
		-
			"class": "ClassLikeLabels\\SomeTrait"
		-
			"class": "ClassLikeLabels\\SomeClass"
