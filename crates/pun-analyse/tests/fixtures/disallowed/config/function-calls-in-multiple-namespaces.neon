parameters:
	level: 0
	scanDirectories:
		- ../src
	filesRootDir: %currentWorkingDirectory%/tests/fixtures/disallowed
	paths:
		- "../src/FunctionInMultipleNamespaces.php"
	disallowedFunctionCalls:
		-
			"function": "__()"
			"message": "use MyNamespace\\__ instead"
		-
			"function": "MyNamespace\\__()"
			"message": "ha ha ha nope"
		-
			"function": "printf()"
