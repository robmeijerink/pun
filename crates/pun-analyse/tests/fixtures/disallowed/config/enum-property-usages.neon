parameters:
	level: 0
	scanDirectories:
		- ../src
	filesRootDir: %currentWorkingDirectory%/tests/fixtures/disallowed
	paths:
		- "../src/disallowed/enumPropertyUsages.php"
		- "../src/disallowed-allow/enumPropertyUsages.php"
	disallowedProperties:
		-
			"property": "Enums\\BackedEnum::value"
			"allowIn": 
				- "src/disallowed-allow/*.php"
				- "src/*-allow/*.*"
