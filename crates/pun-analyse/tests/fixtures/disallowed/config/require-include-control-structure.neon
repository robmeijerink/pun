parameters:
	level: 0
	scanDirectories:
		- ../src
	filesRootDir: %currentWorkingDirectory%/tests/fixtures/disallowed
	paths:
		- "../src/disallowed/controlStructures.php"
		- "../src/disallowed-allow/controlStructures.php"
	disallowedControlStructures:
		-
			"controlStructure": 
				- "require"
				- "include"
				- "require_once"
				- "include_once"
			"allowIn": 
				- "src/disallowed-allow/*.php"
				- "src/*-allow/*.*"
