parameters:
	level: 0
	scanDirectories:
		- ../src
	filesRootDir: %currentWorkingDirectory%/tests/fixtures/disallowed
	paths:
		- "../src/disallowed/firstClassCallable.php"
		- "../src/disallowed-allow/firstClassCallable.php"
	disallowedMethodCalls:
		-
			"method": "Waldo\\Quux\\Blade::run*()"
			"message": "I've seen tests you people wouldn't believe"
			"allowIn": 
				- "src/disallowed-allow/*.php"
				- "src/*-allow/*.*"
