parameters:
	level: 0
	scanDirectories:
		- ../src
	filesRootDir: %currentWorkingDirectory%/tests/fixtures/disallowed
	paths:
		- "../src/disallowed/namespaceUsagesExcludeAttribute.php"
	disallowedNamespaces:
		-
			"namespace": "NoBigDeal\\*"
			"message": "no private modules"
			"excludeWithAttribute": 
				- "\\Attributes\\*Class"
